{
  "expo": {
    "name": "Sununo",
    "slug": "Sununo",
    "version": "8.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sununo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/391462b3-5778-4922-81bb-63fe765d070c",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sununo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج الوصول لموقعك لإظهار الشاليهات القريبة منك وتحديد موقع شاليك على الخارطة.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "نحتاج الوصول لموقعك لإظهار الشاليهات القريبة منك وتحديد موقع شاليك على الخارطة.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "UD89399RJ8",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:sununo.app",
        "webcredentials:sununo.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#045CFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "package": "com.sununo.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sununo.app",
              "pathPrefix": "/ar/chalets"
            },
            {
              "scheme": "https",
              "host": "sununo.app",
              "pathPrefix": "/en/chalets"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "@rnmapbox/maps",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "./plugins/withNonModularHeaders"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "391462b3-5778-4922-81bb-63fe765d070c"
      }
    }
  }
}
